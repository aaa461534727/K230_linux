#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""k230-bt-hid — 让 K230 当 **BLE HID 外设 (HOGP: 鼠标 + 键盘)**, 手机连上后
可以用板子的触摸屏 / 控制命令去操作手机 (苹果 AirPlay 反控的唯一可行路径)。

为什么是蓝牙而不是 WiFi (2026-11-04 定论, 见 docs/BT_HID_REVERSE_PLAN.md):
  · AirPlay **屏幕镜像**是单向流 (手机 → 接收端), 协议里没有回传触摸的通道;
    反控属于 CarPlay (`/command` + iAP2 + MFi-SAP 密钥), 需要 MFi 认证芯片。
  · 安卓的 Miracast 有 **UIBC** (本板已跑通), 所以安卓优先 UIBC, 蓝牙只是兜底。
  · iOS 没有别的路: 只能让板子装成"系统级输入设备" = 蓝牙鼠标/键盘 (海奇同原理)。

实现要点 (为什么这么写):
  · 用 BLE **HOGP** 而不是经典蓝牙 HID: Linux 内核只实现了经典 HID 的**主机端**,
    设备端要在 L2CAP 上自己写协议; BLE 这边只要 BlueZ 的 GATT/广播 D-Bus 接口,
    userspace 就能做 (本板 BlueZ 5.72 + GattManager1 + LEAdvertisingManager1 都有)。
  · HID 服务 (0x1812) 的特征都带 `encrypt-*` 权限 —— 真 HID 设备的做法,
    手机连上会先配对 (Just Works), 之后才读 Report Map / 订阅 Report。
  · 触摸源 `/dev/input/event0` (FT5x06) 是**绝对坐标**; BLE 鼠标只认**相对位移**,
    所以这里做 绝对 → 相对 的换算 (一个 SYN 帧的位移合并后按 127 一段发),
    并实现 点按 / 拖动 / 双击 / 双指滚动。
  · 控制管道 `/run/k230-bt-hid.fifo` 让别的程序 (或 adb 自测) 不用摸屏也能注入事件。

用法:
  k230-bt-hid run                 # 前台跑 (systemd 用这个); 注册 GATT + 开始广播
  k230-bt-hid status              # 看运行状态 (广播/配对/已发多少报告)
  k230-bt-hid send "<命令>"       # 往控制管道写一条命令
  k230-bt-hid selftest            # 不用手机也能自检: 画个方块 + 单击 + 打字
  k230-bt-hid dump                # 把 GATT 结构打出来 (调试注册用)

控制管道命令 (一行一条):
  move <dx> <dy>              鼠标相对移动 (仅 rel 模式; abs 模式请用 tap/at)
  tap <u> <v>                 归一化 (0~1) 绝对定位 + 点击 ← abs 模式主用
  at <px> <py>                绝对定位 (镜像像素) 不点击
  reanchor                    把指针锚回内容区左上角 (位置丢了用)
  cal                         打印绝对定位的几何/增益/已知位置
  wheel <n>                   滚轮 (正=向下)
  click [left|right|middle] [n]
  down|up [left|right|middle]
  key <usage> [down|up|tap] [mod]   HID 键码 (0x04='a'; mod 0x08=Cmd ⇒ 0x08 + 0x0B = Cmd+H 回主屏)
  text <ascii...>             按 US 布局打一串 ASCII
  consumer <usage>            多媒体键 (如 0xCD = 播放/暂停)
  status                      往日志打一行统计

退出码: 0 正常; 2 参数错; 3 蓝牙不可用 (无 hci0 / BlueZ 未跑)。
"""

import argparse
import json
import os
import re
import signal
import socket
import struct
import subprocess
import sys
import time

try:
    import dbus
    import dbus.service
    import dbus.mainloop.glib
    from gi.repository import GLib
except ImportError as e:  # pragma: no cover
    print("k230-bt-hid: 缺 python3-dbus / python3-gi (%s)" % e, file=sys.stderr)
    sys.exit(3)

# 必须先把 dbus 绑到 GLib 主循环: 否则 export 对象 / 收信号 / 异步调用全部 RuntimeError
dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)

# ---------------------------------------------------------------- 常量
ADAPTER = os.environ.get("K230_BT_HID_ADAPTER", "/org/bluez/hci0")
DEVICE_NAME = os.environ.get("K230_BT_HID_NAME", "K230-CAST")
APP_PATH = "/org/k230/bthid"
ADV_PATH = "/org/k230/bthid/adv"
AGENT_PATH = "/org/k230/bthid/agent"
# 2026-11-06 改: NoInputNoOutput → DisplayYesNo。
#   安卓手机重新配对时会要求 MITM 保护 (btmon: IO Capability Response 里
#   `Authentication: Dedicated Bonding - MITM required`), 走 Numeric Comparison;
#   而 NoInputNoOutput 的 agent 只能 Just Works, BlueZ 收到 User Confirmation Request 后
#   1.2 ms 内直接回 HCI `User Confirmation Request Neg Reply` ⇒ 手机侧显示"配对失败",
#   现场表现是"任何手机都连不上"(2026-11-06 09:44 btmon 实测)。
#   DisplayYesNo 才允许 Numeric Comparison; PairAgent 仍自动确认 (车机无人值守场景)。
#   对端不要求 MITM 时 DisplayYesNo 照样走 Just Works, 不退化。
AGENT_CAPABILITY = "DisplayYesNo"
PROFILE_PATH = "/org/k230/bthid/profile"

# 经典 HID (BR/EDR) 的两个 L2CAP 通道 (HID 规范 1.1 / 蓝牙 Assigned Numbers):
#   0x0011 = 控制通道 (SET/GET REPORT, SET_PROTOCOL ...) —— 由 BlueZ profile 交给我们 fd
#   0x0013 = 中断通道 (设备发 input report 用)          —— BlueZ 一个 UUID 只能挂一个 PSM,
#                                                          所以这条自己开裸 L2CAP server
PSM_HID_CONTROL = 0x0011
PSM_HID_INTERRUPT = 0x0013
STATUS_FILE = os.environ.get("K230_BT_HID_STATUS", "/run/k230-bt-hid.status")
# 守护进程在 system bus 上的唯一名: GATT 对象挂在**本进程连接**上, 另一个进程要
# 查这张表 (k230-bt-hid dump) 必须知道这个 :1.NNN, 所以启动时落盘。
NAME_FILE = os.environ.get("K230_BT_HID_NAME_FILE", "/run/k230-bt-hid.name")
FIFO = os.environ.get("K230_BT_HID_FIFO", "/run/k230-bt-hid.fifo")
EVDEV = os.environ.get("K230_BT_HID_EVDEV", "/dev/input/event0")
# 自测/实验室: 设了它, 所有 HID 报告都不走蓝牙, 只追加成 "<时间戳> <类型> <十六进制>"
# 一行 —— 让 scripts/k230-tp-e2e-test.py 能在没有手机的情况下验证报告内容和时序。
SINK = os.environ.get("K230_BT_HID_SINK") or None

# 手感参数 (现场想调只改环境变量)
SENS = float(os.environ.get("K230_BT_HID_SENS", "2.2"))   # 触摸像素 → 鼠标位移倍率
CLICK_MOVE_PX = 14        # 按下后移动超过这么多像素就判"拖动"而不是"点击"
MOVE_DEADBAND = 4         # 手指抖动死区: 位移累计超过这么多像素才真正发 HID 报告
CLICK_MAX_MS = 280        # 按下到抬起短于这个算点击
DRAG_HOLD_MS = 200        # 按住超过这个时间且已在移动 ⇒ 开始拖
SCROLL_STEP_PX = 26       # 双指移动多少像素折算 1 格滚轮
MAX_DELTA = 127           # 单个 HID 报告最大位移

# 三条报告的 struct 格式 (Report ID + 数据, 小端) —— 必须和 REPORT_MAP 里的位宽一致,
# k230-bt-hid-logic-test 会把两边对上 (desc 位宽 ↔ struct.calcsize)。
FMT_MOUSE = "<BBbbb"      # id, buttons, dx, dy, wheel   = 1+1+3 = 5 B
FMT_KEY = "<BBB6B"        # id, modifiers, reserved, 6 keys = 1+8 = 9 B
FMT_CONS = "<BH"          # id, 16-bit usage              = 1+2 = 3 B
# 绝对触摸 (HID 数字化仪 / Touch Screen), 2 指固定长度:
#   id(1) + 指0[标志(1) X(2) Y(2)] + 指1[标志(1) X(2) Y(2)] = 11 B
#   标志字节位序必须和下面的描述符一致: bit0=Tip Switch, bit1=In Range,
#   bit2~6=Contact ID(5 bit), bit7=Contact Count。
FMT_TP = "<BBHHBHH"       # id, f0, x0, y0, f1, x1, y1  = 11 B
TP_LOGICAL_MAX = 1920     # 描述符里 X/Y 的 Logical Maximum (与海奇 AC632GX 一致)
TP_MAX_FINGERS = 2
TP_MIN_INTERVAL = 0.012    # 纯移动帧的最小间隔 (12 ms ≈ 83 Hz, 够跟手又不塞爆经典蓝牙队列)
# 一次接触最短保持多久再发"抬起" (2026-11-06 真机取证后加):
# 板上日志里成功的点击都是 75~96 ms, 主人反馈"点了没反应 / 像长按"的那几下正好都是
# 35~38 ms —— 比真人手指还短 (面板报得快)。iOS 侧把 HID 输入报告按自己的节拍采进来,
# 38 ms 的接触有可能只被采到一帧: 轻则被当成"一直按着"(只留下高亮), 重则整次点击被丢。
# 这里给接触时间兜个底, 保证手机至少看到两帧按下 + 一帧抬起。60 ms 远小于 iOS 的
# 500 ms 长按阈值, 代价只是松开最多晚 ~25 ms。0 = 关掉 (老行为)。
try:
    TP_MIN_HOLD_MS = int(os.environ.get("K230_BT_HID_MIN_HOLD_MS", "60") or 0)
except ValueError:
    TP_MIN_HOLD_MS = 60

# 抬起帧重复发几遍 (2026-11-06 对照海奇 libhidalgo.so 后加)。
# 海奇 hccast_hid_tp_feed 在"没有接触"时会把同一份 11 B 报告**连发 3 次**
# (0x3a84 / 0x3ac4 / 0x3ad8)。经典蓝牙一个连接间隔只带一包, 抬起帧被后面的
# 事件顶掉一次, iOS 就认为手指还按着 —— 之后所有按下都被当成同一个 contact 的
# 移动(单击变长按)、并且会一直粘着不恢复。多发两遍的代价是 22 B, 值得。
# K230_BT_HID_REL_REPEAT=1 可回到老行为。
try:
    TP_REL_REPEAT = max(1, min(5, int(os.environ.get("K230_BT_HID_REL_REPEAT", "3") or 1)))
except ValueError:
    TP_REL_REPEAT = 3

# 空闲保活 (2026-11-05 真机实测后加): 手机侧空闲 ~4 s 就把链路降进 Sniff, 再往后
# 还会挂 Sniff Subrating; 实测两种后果 —— ① 空闲后第一下触摸要等链路醒来
# (btmon: Exit Sniff→Mode Change Active 24 ms, subrating 建立后 223 ms);
# ② 彻底没流量 ~3 min 后手机侧以 reason=8 (Connection Timeout) 直接断链,
# 控制台就"用着用着不动了"。所以只要连着就每 KEEPALIVE_MS 发一条"无操作"报告,
# 让链路留在 Active。0 = 关掉。可用 K230_BT_HID_KEEPALIVE_MS 覆盖。
# 间隔为什么要 500 ms 而不是 2000: 2026-11-05 在努比亚上对比测过 ——
#   2000 ms: 5 min 内 28 次 Sniff/Subrating, subrating 建立后首触要等 223 ms;
#    500 ms: 100 s 内只有 2 次 Sniff 且没挂上 subrating, 首触直发无等待。
# 手机侧的空闲计时器比 2 s 短, 2 s 压不住; 500 ms 才稳。代价是 ~2 条/s 的空包。
try:
    KEEPALIVE_MS = int(os.environ.get("K230_BT_HID_KEEPALIVE_MS", "500") or 0)
except ValueError:
    KEEPALIVE_MS = 500

# Contact ID 用哪种策略: slot = 只在 0/1 之间轮转 (默认, 2 指触摸屏的正确做法);
# rotate = 0..31 全轮转 (老行为, 实测十几笔后 iOS 拒收); fixed = 恒 1 (A/B 用)。
# 2026-11-06 真机现场: 连滑十几笔后 iOS 把整条触摸 collection 挂掉 (空口报文完整、
# 音量键/键盘正常、只有 Report ID 4 不被消费), 20~30 s 后自己恢复。
# 40 笔纯左右滑对照: rotate 27/40 (第 18~30 笔连挂) / fixed 39/40 ⇒ 根因是 cid 一路涨。
CID_MODE = (os.environ.get("K230_BT_HID_CID_MODE", "slot") or "slot").lower()

