    0x05, 0x01, 0x09, 0x06, 0xA1, 0x01,        # Usage(Keyboard) / Collection(App)
    0x85, 0x02,                                 #   Report ID (2)
    0x05, 0x07, 0x19, 0xE0, 0x29, 0xE7,        #   修饰键 E0..E7
    0x15, 0x00, 0x25, 0x01, 0x75, 0x01, 0x95, 0x08, 0x81, 0x02,
    0x95, 0x01, 0x75, 0x08, 0x81, 0x03,        #   1 字节保留
