# ---------------------------------------------------------------- 经典 HID 的 SDP 记录
# 经典蓝牙的"我是什么设备"是查 SDP 得到的 (BLE 那边是 GATT 特征), 所以要给一条完整
# HID 服务记录: 服务类 0x1124 + 控制 PSM 0x11 + 附加协议 PSM 0x13 + HID 描述符。
# 少任何一条, 手机 (bta_hh) 就会 BTA_HH_OPN_EVT 失败:
#   2026-11-04 实测: 没 SDP 记录时手机报 `BTA_HH_OPN_EVT status=7`;
#   挂上这条记录后 status=0, 且 `bta_hh_co_send_hid_info: dscp_len=144` 描述符被收下。
SDP_XML = """<?xml version="1.0" encoding="UTF-8" ?>
<record>
  <attribute id="0x0000"><uint32 value="0x00010000"/></attribute>
  <attribute id="0x0001"><sequence><uuid value="0x1124"/></sequence></attribute>
  <attribute id="0x0004">
    <sequence>
      <sequence><uuid value="0x0100"/></sequence>
      <sequence><uuid value="0x0003"/><uint8 value="0x11"/></sequence>
      <!-- HIDP (0x0019) 必须出现在协议描述里, 这是 HID 设备 SDP 记录的标准写法;
           缺了它有些主机 (尤其 iOS) 会认为"这不是一个 HID 设备"。 -->
      <sequence><uuid value="0x0019"/></sequence>
    </sequence>
  </attribute>
  <attribute id="0x0005"><sequence><uuid value="0x1002"/></sequence></attribute>
  <attribute id="0x0006">
    <sequence><uint16 value="0x656e"/><uint16 value="0x006a"/><uint16 value="0x0100"/></sequence>
  </attribute>
  <attribute id="0x0009">
    <sequence><sequence><uuid value="0x1124"/><uint16 value="0x0101"/></sequence></sequence>
  </attribute>
  <attribute id="0x000d">
    <sequence>
      <sequence>
        <sequence><uuid value="0x0100"/></sequence>
        <sequence><uuid value="0x0003"/><uint8 value="0x13"/></sequence>
        <sequence><uuid value="0x0019"/></sequence>
      </sequence>
    </sequence>
  </attribute>
  <attribute id="0x0100"><text value="%(name)s"/></attribute>
  <attribute id="0x0101"><text value="K230 reverse control HID (mouse+keyboard)"/></attribute>
  <!-- ★ 2026-11-05 修: 这一段原来 0x020A 往后**类型整体错位** (0x020A 写成 uint16,
       0x020C 写成 boolean, 0x020E 写成 uint16 …), 末尾还多了两个不存在的属性
       0x020F/0x0210。iOS 解析 HID SDP 记录比 BlueZ 严, 属性类型对不上就会
       "连接不成功"。下面按 HID Profile 1.1 规范 ID↔类型一一对应。 -->
  <attribute id="0x0200"><uint16 value="0x0111"/></attribute>   <!-- HIDDeviceReleaseNumber -->
  <attribute id="0x0201"><uint16 value="0x0111"/></attribute>   <!-- HIDParserVersion -->
  <attribute id="0x0202"><uint8 value="0xc0"/></attribute>      <!-- HIDDeviceSubclass: 键盘+指点 -->
