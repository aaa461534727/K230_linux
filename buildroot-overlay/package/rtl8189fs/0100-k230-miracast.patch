+#ifdef CONFIG_P2P
+/* K230 (2026-10-20): 上游 wpa_supplicant (cfg80211) 把 P2P IE / WFD IE 放在
+ * "额外 IE" 里 (start_ap 的 beacon_ies / proberesp_ies), 而原厂 start_ap 只用了
+ * settings->beacon.head/tail。
+ * 后果: rtw_add_beacon() 里 "先看到 P2P IE 才启用 GO 角色" 的逻辑不触发,
+ * issue_beacon()/issue_probersp() 的 GO 分支不会追加 P2P IE 和 WFD IE,
+ * 抓包实测 beacon / probe-resp 只有 222 B 且最后一个 IE 是 WPS ⇒ 手机
+ * Wi-Fi Direct + WFD 扫描直接丢掉本 sink (海奇板同样场景是 285 B 三 IE 齐全)。
+ * 这里把额外 IE 交给驱动自己的解析函数, 并直接置好 GO 角色
+ * (不走 rtw_p2p_enable(), 它在 CONFIG_CONCURRENT_MODE 下要求
+ *  iface_id == sel_p2p_iface, 而 GO 跑在 wlan1 会失败)。
+ * type: 0x1=beacon 0x2=probe_resp 0x4=assoc_resp
+ */
+/* K230 (2026-10-22): 把对外宣告的 P2P Group Capability 改成指定值。
+ * 背景: 我们是常驻 GO, supplicant 报 group_capab=0x0b (GO|Persistent|IntraBSS);
+ * 而能连上的海奇板虽然也在跑组, 对外报的是 0x00。实测同一台 Win10:
+ *   · 看到 0x0b 的 K230 -> 发完 PD Request 就再不说话 (零 GO-Neg / 零 Invitation)
+ *   · 若对端 group_capab=0x82 (Win10 自报) 双方都是 GO, 协商无从谈起
+ * P2P Capability 属性布局: id(1) + len(2, LE) + dev_capab(1) + group_capab(1)。
+ * 就地改写 supplicant 传来的额外 IE 缓冲 (cfg80211 的请求内存), 空口立即生效。 */
+static void rtw_k230_force_group_capab(u8 *ies, size_t ies_len, u8 val)
+{
+	size_t i = 0;
+
+	while (i + 2 <= ies_len) {
+		u8 id = ies[i], elen = ies[i + 1];
+		u8 *p = ies + i + 2;
+		size_t j = 4;   /* OUI(3) + type(1) */
+
+		if (i + 2 + elen > ies_len)
+			break;
+		if (id == 221 && elen >= 8 && p[0] == 0x50 && p[1] == 0x6f &&
+		    p[2] == 0x9a && p[3] == 0x09) {
+			while (j + 3 <= elen) {
+				u8 aid = p[j];
+				u16 alen = (u16)(p[j + 1] | (p[j + 2] << 8));
+
+				if ((size_t)j + 3 + alen > elen)
+					break;
+				if (aid == 2 && alen == 2) {   /* P2P Capability */
+					if (p[j + 4] != val) {
+						pr_info("K230P2P: group_capab 0x%02x -> 0x%02x\n",
+							p[j + 4], val);
+						p[j + 4] = val;
+					}
+					return;
+				}
+				j += 3 + alen;
+			}
+		}
+		i += 2 + elen;
+	}
+}
+
+static void rtw_k230_p2p_apply_extra_ies(struct net_device *ndev, const u8 *ies,
+					 size_t ies_len, int type)
+{
+	_adapter *adapter = (_adapter *)rtw_netdev_priv(ndev);
+	struct wifidirect_info *pwdinfo = &(adapter->wdinfo);
+	u32 p2p_ielen = 0;
+	u8 *p2p_ie;
+
+	if (!ies || !ies_len)
+		return;
+
+	/* 对端 (Win10 自报 group_capab=0x82) 与我们都宣称自己是 GO 时, 协商直接死掉;
+	 * 对齐海奇的做法: 对外报 0x00 (空闲设备), 由对端决定建组方式。 */
+	rtw_k230_force_group_capab((u8 *)ies, ies_len, 0x00);
+
+	p2p_ie = rtw_get_p2p_ie((u8 *)ies, ies_len, NULL, &p2p_ielen);
+	pr_info("K230P2P: extra ies type=%d len=%zu p2p_ielen=%u\n",
+		type, ies_len, p2p_ielen);
+
+	if (type == 0x1 && p2p_ie && p2p_ielen > 0) {
+		rtw_p2p_set_role(pwdinfo, P2P_ROLE_GO);
+		rtw_p2p_set_state(pwdinfo, P2P_STATE_GONEGO_OK);
+		pwdinfo->intent = 15;
+#ifdef CONFIG_IOCTL_CFG80211
+		adapter_wdev_data(adapter)->p2p_enabled = _TRUE;
+#endif
+		adapter->stapriv.expire_to = 3;
+	}
+
+	rtw_cfg80211_set_mgnt_wpsp2pie(ndev, (char *)ies, ies_len, type);
+}
+#endif /* CONFIG_P2P */
