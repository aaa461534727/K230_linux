--- a/wpa_supplicant/p2p_supplicant.c
+++ b/wpa_supplicant/p2p_supplicant.c
@@ -1742,6 +1742,28 @@
 			  res->ssid, res->ssid_len);
 	wpa_supplicant_ap_deinit(wpa_s);
 	wpas_copy_go_neg_results(wpa_s, res);
+	/*
+	 * K230: 手机 GO 把组建在 ch8(2447), 而我们自己的 P2P Listen 信道是
+	 * ch6(2437). GO Negotiation 成功后 wpa_supplicant 仍会在 listen 信道上
+	 * 发起一个 5000 ms 的 remain-on-channel, 射频被占住, 排队等待的定向
+	 * scan(2447) 只能等 ROC 结束才轮得上, 结果第一帧 Authentication 要到
+	 * 5.3 s 之后才发得出去 (RT5572 空口实测 89.58s -> 94.89s).
+	 * 组信道此时已经由 GO Negotiation 确定, 无需再在 listen 信道上守株待兔,
+	 * 直接停掉 find/listen 并取消 ROC, 让扫描与认证立刻在组信道上执行
+	 * (与 join-running-group 路径下的处理一致).
+	 */
+	if (wpa_s->global->p2p) {
+		wpa_printf(MSG_DEBUG, "K230: Stop P2P find/listen before "
+			   "association (group channel takes priority)");
+		p2p_stop_find(wpa_s->global->p2p);
+	}
+	if (wpa_s->off_channel_freq || wpa_s->roc_waiting_drv_freq) {
+		wpa_printf(MSG_DEBUG, "K230: Cancel remain-on-channel before "
+			   "association");
+		wpa_drv_cancel_remain_on_channel(wpa_s);
+		wpa_s->off_channel_freq = 0;
+		wpa_s->roc_waiting_drv_freq = 0;
+	}
 	if (res->wps_method == WPS_PBC) {
 		wpas_wps_start_pbc(wpa_s, res->peer_interface_addr, 1, 0);
 #ifdef CONFIG_WPS_NFC
