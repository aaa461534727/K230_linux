#!/bin/sh
# k230-airplay —— 苹果 AirPlay 投屏接收 (UxPlay 只跑协议, 视频交给本板硬解)
#
# 链路: uxplay ──(H.264 Annex-B)──► /run/airplay.h264 (命名管道)
#                                     └─► v4l2_dec (VPU 硬解) ──► /run/wfd-player.fifo
#                                                                   └─► drmplay (常驻上屏)
#
# 为什么不用 UxPlay 自己的 GStreamer 上屏: K230 是单核 RISC-V, 软解 720p/1080p 跑不动;
# 本板有 VPU 硬解, 而且 Miracast 那条链路已经把「硬解 → 常驻播放器」打磨好了, 直接复用。
#
# 用法: k230-airplay [run]    (默认 run; systemd 直接调用)
set -u

NAME="${AIRPLAY_NAME:-K230-CAST}"
ES_FIFO="${AIRPLAY_ES_FIFO:-/run/airplay.h264}"
PLAYER_FIFO="${WFD_PLAYER_FIFO:-/run/wfd-player.fifo}"
PLAYER_PIDFILE="${WFD_PLAYER_PID:-/run/wfd-player.pid}"
PLAYER_OPTS="${WFD_PLAYER_OPTS:--H -p nv12 -w 480 -h 800}"
UXPLAY="${UXPLAY_BIN:-/usr/local/bin/uxplay}"
LOG="${AIRPLAY_LOG:-/var/log/airplay.log}"
ACTIVE_FILE="${AIRPLAY_ACTIVE_FILE:-/run/airplay-active}"

log() { printf '[%s] %s\n' "$(date +%H:%M:%S)" "$*" >>"$LOG"; }

ensure_player() {
    # ★ 2026-10-27: 本函数原来也自己「pkill -B → rm -f 管道 → mkfifo → setsid drmplay」。
    #   和 k230-screen.sh / wfd-p2p.sh 三份逻辑撞在一起时, 后到的会把别人刚建好的管道
    #   inode 删掉 ⇒ 活着的玩家 fd 指向 (deleted) inode, 新管道没有读者 ⇒ 解码器 fopen
    #   永久阻塞 ⇒ 「手机提示投屏成功但屏上全黑」(现场 16:00)。现在**只体检, 不起玩家**,
    #   不健康就交给唯一所有者 k230-screen.service (Restart=always) 重新接管。
    #
    # 体检判据 (三个都要过):
    #   ① pidfile 里的 pid 活着
    #   ② 该 pid 的 fd 0 指向**当前**管道 (不能是 "...(deleted)")
    #   ③ 管道本身还在 (S_ISFIFO)
    player_ok() {
        _pp=$(cat "$PLAYER_PIDFILE" 2>/dev/null || echo 0)
        if [ -z "$_pp" ] || [ "$_pp" = 0 ] || ! kill -0 "$_pp" 2>/dev/null; then
            # pidfile 缺失/过期: 退回按命令行找 (老版本 k230-screen.sh 不写 pidfile)
            _pp=$(pgrep -f "drmplay .*-F $PLAYER_FIFO" 2>/dev/null | head -1)
        fi
        [ -n "$_pp" ] || return 1
        [ -p "$PLAYER_FIFO" ] || return 1
        _tgt=$(readlink "/proc/$_pp/fd/0" 2>/dev/null || echo "")
        case "$_tgt" in
            *"(deleted)") return 1 ;;
            *"$PLAYER_FIFO") return 0 ;;
            *) return 1 ;;
        esac
    }
    if player_ok; then
        return 0
    fi
    log "⚠ 常驻播放器不健康 (pidfile/管道 inode 不匹配) → 重启 k230-screen 重新接管"
    systemctl restart k230-screen.service 2>/dev/null || true
    sleep 1.5
    if player_ok; then
        log "✅ 播放器已由 k230-screen 重新接管"
    else
        log "⚠ 重启后仍不健康 (黑屏风险): 看 /var/log/k230-screen.log"
    fi
    return 0
}

watch_decoder() {
    # ★ 2026-10-29 (现场黑屏): 同一 uxplay/解码器会跨多场会话复用 (uxplay 不退出就
    #   只是会话结束)。第二场起偶发 **MVX 硬件解码看门狗超时** (dmesg 每 3 s 一条
    #   "MVX session ... Watchdog timeout"), 解码器 60~80% CPU 空转、不读 ES 管道
    #   ⇒ uxplay 写管道阻塞 ⇒ Mac 发送窗口被塞满 (Recv-Q 冲到 3.7 MB) 停发
    #   ⇒ 屏全黑、音频照旧。此前只能整服务重启才能恢复。
    #   两路判据, 命中就杀掉解码器, 让 start_decoder 的循环重开:
    #     ① 内核 MVX Watchdog 计数增加 = 硬件解码器已挂 (最准, 无假阳性)
    #     ② 客户端连着 (:7000 ESTAB) 但解码日志 12 s 不增长 = 软性卡死
    _wd_last=$(dmesg 2>/dev/null | grep -c 'MVX session.*Watchdog timeout')
    _wd_size=$(stat -c %s /var/log/miracast-dec.log 2>/dev/null || echo 0)
    _wd_quiet=0
    _wd_was=0
    while :; do
        sleep 2
        _conn=0
        ss -tn 2>/dev/null | grep -q 'ESTAB.*:7000 ' && _conn=1
        # 会话存活标记: drmplay 见到它就无限期保持最后一帧 (静止桌面不刷黑)
        if [ "$_conn" = 1 ]; then
            [ -f "$ACTIVE_FILE" ] || : >"$ACTIVE_FILE"
        elif [ -f "$ACTIVE_FILE" ]; then
            rm -f "$ACTIVE_FILE"
        fi
        # 会话结束 (连过又断开): 整单元重启一次, 让 uxplay/解码器都从干净状态
        # 等下一场 —— 跨会话复用同一个解码器正是 15:03「有声音没画面」的现场
        # (第二场起 MVX 偶尔挂死 / QBUF 报 EIO, 只能重启才能恢复)。
        if [ "$_wd_was" = 1 ] && [ "$_conn" = 0 ]; then
            _wd_was=0
            log "⏹ AirPlay 会话结束 → 2 s 后重启本单元 (解码器归零)"
            ( sleep 2; ss -tn 2>/dev/null | grep -q 'ESTAB.*:7000 ' || systemctl --no-block restart k230-airplay.service ) &
            continue
        fi
        [ "$_conn" = 1 ] && _wd_was=1
        # ① 内核 MVX 看门狗计数增加 = 硬件解码器已挂 → 整单元重启 (只杀进程不够,
        #   实测杀完重开的解码器会一直 QBUF EIO)
        _wd_now=$(dmesg 2>/dev/null | grep -c 'MVX session.*Watchdog timeout')
        if [ "$_wd_now" -gt "$_wd_last" ]; then
            log "⚠ MVX 看门狗超时 +$((_wd_now - _wd_last)) → 重启本单元 (硬件解码器已挂)"
            _wd_last=$_wd_now
            systemctl --no-block restart k230-airplay.service
            exit 0
        fi
        # ★ 2026-10-29 实测否决「日志不增长 = 卡死」这条判据: 解码器的日志是
        #   stdio 块缓冲 (重定向到文件后 4 KB 才落一次), 健康的会话也会 20~30 s
        #   一个字都不落盘 ⇒ 会把正常投屏误杀 (现场 15:37:39 就是这么断的)。
        #   只保留上面的 MVX 看门狗判据 (内核日志, 精确, 无假阳性)。
    done
}

start_decoder() {
    rm -f "$ES_FIFO"
    mkfifo "$ES_FIFO" 2>/dev/null || true
    chmod 666 "$ES_FIFO" 2>/dev/null || true
    # 自己持有一个读写端: ① 管道永远有写端 ⇒ v4l2_dec 的 open(O_RDONLY) 立刻返回,
    # 不会卡在 open 上等 uxplay; ② 解码器重启的那 0.5 s 里 uxplay 写管道也不会
    # 拿到 EPIPE/SIGPIPE (否则 uxplay 直接被打死, 表现为「投上去就断」)。
    exec 9<>"$ES_FIFO"
    # 看护循环: 解码器退出 (上一路码流 EOF / 会话结束) 立刻重开管道等下一次。
    # 少了这个循环, 第一路会话结束后就再也没人解码 ⇒ 第二次投屏只有声音没有画面。
    # 故意**不 setsid**: 让子进程留在本 unit 的 cgroup 里, systemctl stop 时一起收掉,
    # 不会留下一个抱着 /run/wfd-player.fifo 的僵尸解码器挡 Miracast。
    (
        while :; do
            # ★ 2026-10-29 (黑屏现场): 这里原来带 -A (autofit)。-A 会在解到第 12 帧时
            #   **exec 重启自己** (learn_restart: 把已收码流写 /tmp/dec-replay.h264,
            #   再带硬件裁剪/缩放参数重新 exec)。主人报的现象正是
            #   「有图像出来了, 然后黑屏」, 日志紧跟:
            #     [09:49:01] ⚠ 等 SPS 超时 30s (没拿到码流头)
            #     [09:49:29] ⚠ 空缓冲 … 流没起来, 等 source
            #   —— 重启后接不上 uxplay 正在写的管道, 一帧都出不来。
            #   而且 AirPlay 这条路的几何适配本来就不靠 -A: 下游 drmplay 带
            #   `-w 480 -h 800` 自己缩放补边 (Miracast 那条路一直这么干, 稳)。
            #   要回来调画面占比时用 AIRPLAY_AUTOFIT=1 临时开。
            /usr/bin/v4l2_dec "$ES_FIFO" "$PLAYER_FIFO" -H -D ${AIRPLAY_AUTOFIT:+-A} \
                >>/var/log/miracast-dec.log 2>&1 </dev/null
            _rc=$?
            printf '[%s] 硬解退出 (rc=%d) → 0.5s 后重开管道等下一次投屏\n' \
                "$(date +%H:%M:%S)" "$_rc" >>"$LOG"
            sleep 0.5
        done
    ) &
    DEC_PID=$!
    watch_decoder &
    WATCH_PID=$!
    log "硬解已起 (pid $DEC_PID, 输入 $ES_FIFO, 看护 pid $WATCH_PID)"
}

wait_port_free() {
    # ★ 2026-10-28: 上一实例没退干净时立刻再起, uxplay 抢不到 7001 端口 ——
    #   现场 18:31:54 / 18:32:06 / 18:32:21 连炸三次 rc=139(段错误), 都是紧跟在上一次
    #   "Stopping RAOP Server..." 之后 3 秒内重启造成的。先等端口放掉, 再交给 systemd
    #   的 RestartSec 节奏, 段错误就不出现了。
    _i=0
    while [ $_i -lt 24 ]; do
        if ! ss -lnt 2>/dev/null | grep -q ':7001 '; then return 0; fi
        _i=$((_i + 1))
        sleep 0.5
    done
    log "⚠ 7001 端口 12 s 仍被占用 (疑似残留 uxplay), 照常启动"
}

status() {
    printf '服务     : %s\n' "$(systemctl is-active k230-airplay 2>/dev/null)"
    printf '名字     : %s\n' "$NAME"
    printf 'uxplay   : %s\n' "$(pgrep -f 'uxplay -n' | tr '\n' ' ')"
    printf 'rtsp端口 : %s\n' "$(ss -lnt 2>/dev/null | awk '/:7001 /{print "7001 LISTEN"; exit}')"
    printf '解码器   : %s\n' "$(pgrep -f "v4l2_dec $ES_FIFO" | tr '\n' ' ')"
    printf '播放器   : %s (geom: %s)\n' "$(cat "$PLAYER_PIDFILE" 2>/dev/null || echo -)" "$(cat /run/wfd-uibc-geom 2>/dev/null || echo -)"
    printf -- '--- 最近日志 ---\n'
    tail -12 "$LOG" 2>/dev/null
}

cleanup() {
    # 先杀看护循环 (它一死就不会再 fork 新的解码器), 再杀它的**直接子进程**。
    # ⚠ 不能写 pkill -f "v4l2_dec $ES_FIFO": 重启时旧实例的 cleanup 会晚几秒跑,
    #    按名字杀会把**新实例刚起的解码器**一起打死 (实测 21:43:09 rc=137 就是它)。
    if [ -n "${WATCH_PID:-}" ]; then
        kill -9 "$WATCH_PID" 2>/dev/null || true
    fi
    if [ -n "${DEC_PID:-}" ]; then
        kill -9 "$DEC_PID" 2>/dev/null || true
        for _c in $(pgrep -P "$DEC_PID" 2>/dev/null); do kill -9 "$_c" 2>/dev/null || true; done
    fi
    # ★ 2026-10-28: 上面只杀「本实例记住的那棵树」。实测重编+重启后 /proc 里仍留着
    #   上一实例的 v4l2_dec (现场 pid 708278 从 21:04 活到 21:44), 两个解码器同时读
    #   同一个命名管道 ⇒ H.264 字节流被对半劈开, 谁都凑不出 SPS, 画面永远黑。
    #   只有在「本进程仍是 k230-airplay 的 MainPID」时才按名字清扫: 若已不是, 说明
    #   新实例起来了, 按名字杀会把它的解码器一起打死 (21:43:09 rc=137 老坑)。
    _cur=$(systemctl show -p MainPID --value k230-airplay 2>/dev/null)
    if [ "${_cur:-0}" = "$$" ]; then
        for _p in $(pgrep -f "v4l2_dec $ES_FIFO" 2>/dev/null); do kill -9 "$_p" 2>/dev/null || true; done
    fi
    exec 9>&- 2>/dev/null || true
    rm -f "$ES_FIFO" 2>/dev/null || true
    rm -f "$ACTIVE_FILE" 2>/dev/null || true
    log "airplay 结束"
}
trap cleanup EXIT INT TERM

case "${1:-run}" in
    run)
        [ -x "$UXPLAY" ] || { log "✗ 找不到 $UXPLAY"; echo "uxplay 未安装: $UXPLAY" >&2; exit 1; }
        ensure_player
        start_decoder
        # -vdmp 把解密后的 H.264 Annex-B 写到 "<参数>.h264" —— 正好就是 ES_FIFO。
        # 它先对 "<参数>" 做一次可写性检查, 所以那个基名用一个普通空文件占位。
        ES_BASE=$(echo "$ES_FIFO" | sed "s/[.]h264$//")
        touch "$ES_BASE"
        log "启动 AirPlay: name=$NAME es=$ES_FIFO"
        # -n    服务名;  -nh 名字不加 @hostname
        # -vdmp 视频直通到命名管道;  -s 是**向客户端声明的最大镜像尺寸**,
        #   必须和客户端实际会选的尺寸对得上, 否则 macOS 认了连接(显示
        #   "K230-AirPlay 2560x1440 AirPlay")却不推流 —— 现场症状是 uxplay 打完
        #   "raop_rtp_mirror starting mirroring" 就静止, UDP 每秒只有个位数包,
        #   K230 侧 v4l2_dec 一直"等 source"。
        #   2026-10-29 复测 (Mac 本机显示设置已切 1080p): 声明 1280x720@30 与
        #   1920x1080@30 **都会立即推流**, 且 macOS 两种声明下都按 1280x720 开镜
        #   (system_profiler 里 K230-AirPlay Resolution 恒为 1280 x 720) —— 镜像
        #   分辨率由 Mac 决定, -s 只是"我们能收多大", 声明过大不会换来更高分辨率。
        #   所以默认取 1280x720@30 (= 实际收到的), 避免声明的比收到的更大时
        #   Mac 误以为能上 1080p 却按 720p 编码造成协商反复。
        #   ⚠ 解码侧不写死分辨率: v4l2_dec 从 SPS 读, 换成 1080p 源自动跟随。
        #   可用 AIRPLAY_RES 覆盖 (例如 1920x1080@30)。
        # -p 7000 固定端口 (仲裁器按 7000 的已建立连接判断"苹果连上了")
        # 音频: 2026-10-29 打通 —— 板上已 apt 装 gstreamer1.0-plugins-base +
        #   gstreamer1.0-libav (avdec_alac/audioconvert/audioresample/volume/filesink/
        #   appsrc 齐活), UXPLAY_AUDIO_PIPE 那条 pipeline 能正常 parse, 把 AirPlay 的
        #   ALAC 解成 S16LE/48k/2ch 写 /run/wfd-audio.pcm, 由常驻 pcmplay 出声
        #   (与 Miracast 共用同一 ALSA 出口)。单核板 ALAC 软解 CPU 占用极低, 默认开。
        #   关音频: AIRPLAY_AUDIO=0 ./k230-airplay run
        if [ "${AIRPLAY_AUDIO:-1}" = 1 ]; then
            export UXPLAY_AUDIO_PIPE="${AIRPLAY_AUDIO_PIPE:-/run/wfd-audio.pcm}"
            _AUDIO_OPT=""
            log "音频: 开 (PCM → $UXPLAY_AUDIO_PIPE)"
        else
            unset UXPLAY_AUDIO_PIPE
            _AUDIO_OPT="-a"
            log "音频: 关 (-a; 板上无 GStreamer 解码插件)"
        fi
        wait_port_free
        _t0=$(date +%s)
        # ★ 2026-10-28: uxplay 的日志走 stdio, 重定向到文件后是**块缓冲** —— 它一崩
        #   或卡住, 最后十几行全憋在用户态缓冲里, 现场只能看到「服务 active 但没画面」。
        #   有 stdbuf 就按行刷新, 没有就算了 (不影响功能)。
        UX_RUN=""
        command -v stdbuf >/dev/null 2>&1 && UX_RUN="stdbuf -oL -eL"
        $UX_RUN "$UXPLAY" -n "$NAME" -nh -p 7000 -s "${AIRPLAY_RES:-1280x720@30}" -vdmp "$ES_BASE" $_AUDIO_OPT >>"$LOG" 2>&1
        RC=$?
        _t1=$(date +%s)
        log "uxplay 退出 (rc=$RC, 运行 $((_t1 - _t0)) 秒)"
        if [ $RC -ne 0 ]; then
            log "⚠ 异常退出 rc=$RC — 139=段错误(多为上一实例未退净/端口冲突), 143=SIGTERM(正常停止)"
        fi
        exit $RC
        ;;
    status)
        status
        ;;
    *)
        echo "用法: $0 [run|status]" >&2
        exit 2
        ;;
esac
