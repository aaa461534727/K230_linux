# 补丁目标: 8189fs 驱动 os_dep/linux/ioctl_cfg80211.c (RTL8189FS, K230 01Studio 实际在用的 WiFi 驱动)
# 目的: 让 GO 的 beacon/probe-resp 带上 wpa_supplicant 传来的 P2P IE + WFD IE, 手机才能发现 sink
# 应用: cd <sdk>/output/<conf>/build/rtl8189fs-*/ && patch -p0 < 本文件; 然后 make rtl8189fs-rebuild CONF=<conf>

--- /tmp/ioctl_cfg80211_8189fs.c.orig	2025-01-12 23:02:59.000000000 -0800
+++ os_dep/linux/ioctl_cfg80211.c	2026-10-20 20:48:42.001314968 -0700
@@ -4935,6 +4935,48 @@
 	return 0;
 }
 #else
+#ifdef CONFIG_P2P
+/* K230 (2026-10-20): 上游 wpa_supplicant (cfg80211) 把 P2P IE / WFD IE 放在
+ * "额外 IE" 里 (start_ap 的 beacon_ies / proberesp_ies), 而原厂 start_ap 只用了
+ * settings->beacon.head/tail。
+ * 后果: rtw_add_beacon() 里 "先看到 P2P IE 才启用 GO 角色" 的逻辑不触发,
+ * issue_beacon()/issue_probersp() 的 GO 分支不会追加 P2P IE 和 WFD IE,
+ * 抓包实测 beacon / probe-resp 只有 222 B 且最后一个 IE 是 WPS ⇒ 手机
+ * Wi-Fi Direct + WFD 扫描直接丢掉本 sink (海奇板同样场景是 285 B 三 IE 齐全)。
+ * 这里把额外 IE 交给驱动自己的解析函数, 并直接置好 GO 角色
+ * (不走 rtw_p2p_enable(), 它在 CONFIG_CONCURRENT_MODE 下要求
+ *  iface_id == sel_p2p_iface, 而 GO 跑在 wlan1 会失败)。
+ * type: 0x1=beacon 0x2=probe_resp 0x4=assoc_resp
+ */
+static void rtw_k230_p2p_apply_extra_ies(struct net_device *ndev, const u8 *ies,
+					 size_t ies_len, int type)
+{
+	_adapter *adapter = (_adapter *)rtw_netdev_priv(ndev);
+	struct wifidirect_info *pwdinfo = &(adapter->wdinfo);
+	u32 p2p_ielen = 0;
+	u8 *p2p_ie;
+
+	if (!ies || !ies_len)
+		return;
+
+	p2p_ie = rtw_get_p2p_ie((u8 *)ies, ies_len, NULL, &p2p_ielen);
+	pr_info("K230P2P: extra ies type=%d len=%zu p2p_ielen=%u\n",
+		type, ies_len, p2p_ielen);
+
+	if (type == 0x1 && p2p_ie && p2p_ielen > 0) {
+		rtw_p2p_set_role(pwdinfo, P2P_ROLE_GO);
+		rtw_p2p_set_state(pwdinfo, P2P_STATE_GONEGO_OK);
+		pwdinfo->intent = 15;
+#ifdef CONFIG_IOCTL_CFG80211
+		adapter_wdev_data(adapter)->p2p_enabled = _TRUE;
+#endif
+		adapter->stapriv.expire_to = 3;
+	}
+
+	rtw_cfg80211_set_mgnt_wpsp2pie(ndev, (char *)ies, ies_len, type);
+}
+#endif /* CONFIG_P2P */
+
 static int cfg80211_rtw_start_ap(struct wiphy *wiphy, struct net_device *ndev,
 		struct cfg80211_ap_settings *settings)
 {
@@ -4943,6 +4985,9 @@
 
 	RTW_INFO(FUNC_NDEV_FMT" hidden_ssid:%d, auth_type:%d\n", FUNC_NDEV_ARG(ndev),
 		settings->hidden_ssid, settings->auth_type);
+	pr_info("K230P2P: start_ap enter head=%zu tail=%zu bies=%zu pries=%zu\n",
+		settings->beacon.head_len, settings->beacon.tail_len,
+		settings->beacon.beacon_ies_len, settings->beacon.proberesp_ies_len);
 
 	if (rtw_cfg80211_sync_iftype(adapter) != _SUCCESS) {
 		ret = -ENOTSUPP;
@@ -4954,6 +4999,12 @@
 	adapter->mlmeextpriv.mlmext_info.hidden_ssid_mode = settings->hidden_ssid;
 	ret = rtw_add_beacon(adapter, settings->beacon.head, settings->beacon.head_len,
 		settings->beacon.tail, settings->beacon.tail_len);
+#ifdef CONFIG_P2P
+	rtw_k230_p2p_apply_extra_ies(ndev, settings->beacon.beacon_ies,
+		settings->beacon.beacon_ies_len, 0x1);
+	rtw_k230_p2p_apply_extra_ies(ndev, settings->beacon.proberesp_ies,
+		settings->beacon.proberesp_ies_len, 0x2);
+#endif
 
 	if (settings->ssid && settings->ssid_len) {
 		WLAN_BSSID_EX *pbss_network = &adapter->mlmepriv.cur_network.network;
