#!/bin/sh
# k230-iap2-probe —— 有线 CarPlay 可行性探针: 把 Type-C 呈现成 "MFi/CarPlay 配件", 看 iPhone 认不认
#
# 为什么做这个探针 (2026-11-03):
#   CDC-NCM 网卡那条路已证死 —— iPhone 拿到 DHCP 后全程零发包, iOS 不用 USB 以太网做
#   AirPlay 服务发现 (见 docs/WORKLOG.md 10:15 条目)。海奇能"插上就投"是因为它冒充
#   **苹果配件** (iAP2 通道), 不是网卡。本脚本就照那个形态搭一个**最小**配件:
#     functionfs (iAP2 厂商接口) + ncm (给 CarPlay 承载 IP 用)
#   只验证到 **"iPhone 肯当 host 并配置这个接口"** 为止 —— 那一步不通, 后面全白搭。
#
# 安全: 与 k230-usbnet-gadget 同一套闸 —— 先断言 usb0 总线无已枚举设备, 解绑后确认,
#       **全程不写 usb_role** (2026-11-02 三次挂内核都是写 role 引起)。
#
# 用法:
#   k230-iap2-probe on [cppa|elfcast]   呈现配件 (默认 cppa = 标准 CarPlay 配件描述符)
#   k230-iap2-probe off                 撤掉, 还原 g1 (adb+mtp)
#   k230-iap2-probe stat                只读体检
set -u

G=/sys/kernel/config/usb_gadget
UDC_NAME=91500000.usb
USB0_BUS=1
G1="$G/g1"
PG="$G/k230iap2"
FFS=/dev/ffs-iap2
LOG=/var/log/k230-iap2.log
DAEMON=/usr/local/bin/k230-iap2-ffs

log() { echo "[$(date '+%F %T')] $*" | tee -a "$LOG"; }

usb0_has_device() {
    for d in /sys/bus/usb/devices/*/; do
        [ -f "$d/busnum" ] || continue
        [ "$(cat "$d/busnum" 2>/dev/null)" = "$USB0_BUS" ] || continue
        [ "$(basename "$d")" = "usb${USB0_BUS}" ] && continue
        return 0
    done
    return 1
}

cleanup_pg() {
    [ -d "$PG" ] || return 0
    if [ -n "$(cat "$PG/UDC" 2>/dev/null)" ]; then
        echo "" >"$PG/UDC" 2>/dev/null
        sleep 1
    fi
    for l in "$PG"/configs/*/*; do [ -L "$l" ] && rm -f "$l"; done
    rmdir "$PG"/configs/*/strings/* 2>/dev/null
    rmdir "$PG"/configs/* 2>/dev/null
    rmdir "$PG"/functions/* 2>/dev/null
    rmdir "$PG"/strings/* 2>/dev/null
    rmdir "$PG"/os_desc 2>/dev/null
    rmdir "$PG" 2>/dev/null
}

do_off() {
    pkill -f k230-iap2-ffs 2>/dev/null
    if mountpoint -q "$FFS" 2>/dev/null; then
        sleep 1
        umount "$FFS" 2>/dev/null
    fi
    cleanup_pg && log "已移除 k230iap2 gadget"
    if [ -d "$G1" ] && [ -z "$(cat "$G1/UDC" 2>/dev/null)" ]; then
        echo "$UDC_NAME" >"$G1/UDC" 2>/dev/null \
            && log "g1 (adb+mtp) 已重新绑定" \
            || log "⚠ g1 绑定失败 (adbd/mtpd 未就绪, 不影响投屏)"
    fi
}

do_on() {
    kind=${1:-cppa}
    if usb0_has_device; then
        log "✗ usb0(bus$USB0_BUS) 上还有已枚举设备 —— 先拔掉 iPhone 再切"
        return 1
    fi
    modprobe libcomposite 2>/dev/null
    modprobe usb_f_ncm 2>/dev/null
    modprobe usb_f_fs 2>/dev/null

    # 1) 解绑 g1 / 清残留
    #   ⚠ 这里**只能**清自己的 gadget, 不能调 do_off —— do_off 末尾会把 g1 重新绑回去,
    #     紧接着再绑 k230iap2 就会 "echo: I/O error" (2026-11-03 首次跑就这么踩的)。
    pkill -f k230-iap2-ffs 2>/dev/null
    cleanup_pg >/dev/null 2>&1 || true
    if [ -n "$(cat "$G1/UDC" 2>/dev/null)" ]; then
        echo "" >"$G1/UDC" 2>/dev/null
        sleep 1
        log "g1 UDC 已解绑 (现在 = '$(cat "$G1/UDC" 2>/dev/null)')"
    fi

    # 2) 建 gadget —— 描述符照抄 CCPA (CarPlay 通信协议适配器) / 海奇 Elfcasst 两种
    mkdir -p "$PG" && cd "$PG" || return 1
    case "$kind" in
        elfcast)
            echo 0x05ac > idVendor    # 海奇用的: 直接冒充苹果 VID
            echo 0x12ad > idProduct
            echo 0x0404 > bcdDevice
            echo "Elfcast"  > /dev/null
            ;;
        cppa|*)
            echo 0x08e4 > idVendor    # CCPA (MFi CarPlay 适配器) 标准描述符
            echo 0x01c0 > idProduct
            echo 0x0100 > bcdDevice
            ;;
    esac
    echo 0x0200 > bcdUSB
    echo 0xef   > bDeviceClass
    echo 0x02   > bDeviceSubClass
    echo 0x01   > bDeviceProtocol
    echo 0x40   > bMaxPacketSize0

    mkdir -p strings/0x409
    echo "K230IAP2000001" > strings/0x409/serialnumber
    echo "Inc."           > strings/0x409/manufacturer
    echo "K230 CarPlay"   > strings/0x409/product
    mkdir -p configs/c.1/strings/0x409
    echo "CarPlay" > configs/c.1/strings/0x409/configuration
    echo 500       > configs/c.1/MaxPower
    echo 0xc0      > configs/c.1/bmAttributes

    mkdir -p functions/ffs.iap2
    mkdir -p functions/ncm.0
    ln -sf functions/ffs.iap2 configs/c.1/
    ln -sf functions/ncm.0    configs/c.1/

    # 3) 挂 functionfs 并启动描述符写入程序 (必须先于绑 UDC 跑起来)
    mkdir -p "$FFS"
    if ! mountpoint -q "$FFS" 2>/dev/null; then
        mount -t functionfs iap2 "$FFS" || { log "✗ functionfs 挂载失败"; return 1; }
    fi
    setsid "$DAEMON" "$FFS/ep0" >/var/log/iap2-ffs.log 2>&1 &
    sleep 2
    grep -q "descriptors written" /var/log/iap2-ffs.log 2>/dev/null \
        || { log "✗ 描述符没写进去, 见 /var/log/iap2-ffs.log"; return 1; }

    # 4) 绑 UDC
    echo "$UDC_NAME" >UDC 2>/tmp/iap2_bind.err \
        && log "✅ k230iap2 ($kind) 已绑定 $UDC_NAME" \
        || { log "✗ 绑定失败: $(cat /tmp/iap2_bind.err 2>/dev/null)"; return 1; }

    sleep 3
    log "UDC state = $(cat /sys/class/udc/$UDC_NAME/state 2>/dev/null)"
    log "--- iap2-ffs 日志 ---"
    tail -5 /var/log/iap2-ffs.log 2>/dev/null | while read -r l; do log "  $l"; done
}

do_stat() {
    echo "=== usb_role ==="
    for f in /sys/class/usb_role/*/role; do echo "  $(basename $(dirname $f)) = $(cat $f)"; done 2>/dev/null
    echo "=== UDC ==="
    for u in /sys/class/udc/*/; do echo "  $(basename $u) = $(cat $u/state 2>/dev/null)"; done
    echo "=== gadget ==="
    for g in "$G"/*/; do
        [ -d "$g" ] || continue
        echo "  $(basename $g): UDC=$(cat "$g/UDC" 2>/dev/null) funcs=$(ls "$g/functions" 2>/dev/null | tr '\n' ' ')"
    done
    echo "=== usb0 总线 ==="
    usb0_has_device && echo "  有设备" || echo "  空(可安全切换)"
    echo "=== functionfs ==="
    mountpoint -q "$FFS" && echo "  $FFS 已挂载" || echo "  $FFS 未挂载"
    echo "=== iap2-ffs 进程 ==="
    pgrep -af k230-iap2-ffs || echo "  未运行"
    echo "=== usb0 总线设备 (debug) ==="
    ls /sys/bus/usb/devices/ | grep -E "^1-" || echo "  无"
}

case "${1:-stat}" in
    on)   do_on "${2:-cppa}" ;;
    off)  do_off ;;
    stat) do_stat ;;
    *)    echo "用法: $0 on [cppa|elfcast] | off | stat" >&2; exit 2 ;;
esac
