#!/bin/sh
# S96miracast - 开机进入 Miracast P2P client 模式
# K230 2026-10-24: 改为 wfd-p2p.sh client (手机当 GO, K230 拨手机 RTSP :7236)
# 建组后自动配 IP + 起 wfd-sink | v4l2_dec | drmplay; 拆组后自动复位
# 用法: /etc/init.d/S96miracast {start|stop|restart|status}
# 日志: /var/log/miracast-client.log

PIDFILE=/var/run/miracast.pid
LOGDIR=/var/log

start_client() {
    mkdir -p "$LOGDIR"
    echo "S96miracast: 启动 wfd-p2p.sh client"
    setsid sh /root/wfd-p2p.sh client > "$LOGDIR/miracast-client.log" 2>&1 &
    echo $! > "$PIDFILE"
}

stop_client() {
    if [ -f "$PIDFILE" ]; then
        pid=$(cat "$PIDFILE")
        kill -TERM -"$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null
        rm -f "$PIDFILE"
    fi
    pkill -f "/root/wfd-p2p.sh client" 2>/dev/null
    pkill -x wpa_supplicant 2>/dev/null
    pkill -x wfd-sink 2>/dev/null
    pkill -x v4l2_dec 2>/dev/null
    pkill -x drmplay 2>/dev/null
}

case "$1" in
    start)   stop_client; start_client ;;
    stop)    stop_client ;;
    restart) stop_client; sleep 1; start_client ;;
    status)  pgrep -f "/root/wfd-p2p.sh client" >/dev/null && echo "client: running" || echo "client: stopped" ;;
    *) echo "Usage: $0 {start|stop|restart|status}"; exit 1 ;;
esac
exit 0
