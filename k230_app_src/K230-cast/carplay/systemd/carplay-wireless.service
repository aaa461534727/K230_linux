[Unit]
Description=CarPlay wireless (BT iAP2 -> WiFi handoff)
After=carplay-arbiter.service bluetooth.target
Wants=carplay-arbiter.service

[Service]
Type=simple
Environment=CARPLAY_AP_SSID=K230-CARPLAY
Environment=CARPLAY_AP_PASS=k230carplay
Environment=CARPLAY_AP_CHANNEL=6
Environment=CARPLAY_AP_IP=192.168.50.1
ExecStart=/usr/local/bin/carplay-wireless
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
