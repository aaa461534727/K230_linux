[Unit]
Description=K230 CarLife wired (USB AOA) sink
After=network.target k230-screen.service

[Service]
Type=simple
# 2026-11-03 零拷贝 + 最低延迟投喂, 与 k230-screen.sh 必须一致 (见 k230-carlife-wifi.service)
Environment=WFD_SHM=/run/wfd-frame
Environment=DEC_AU=2
ExecStart=/root/carlife_sink --width 1280 --height 720 --fps 30
Restart=always
RestartSec=3
KillMode=control-group
# 2026-11-06: 会话标记的兜底清理 (见 k230-carlife-wifi.service)
ExecStopPost=/bin/rm -f /run/carlife-active

[Install]
WantedBy=multi-user.target
