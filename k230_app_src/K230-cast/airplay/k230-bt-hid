class Char(dbus.service.Object):
    def __init__(self, bus, path, uuid, flags, service_path, value=b""):
        self.path = path
        self.service_path = service_path
        self._notifying = False
        self._value = bytearray(value)
        self._descriptors = []
        self.props = {
            "UUID": dbus.String(uuid),
            "Service": dbus.ObjectPath(service_path),
            "Flags": dbus.Array(list(flags), signature="s"),
            "Value": ba(self._value),
            "Notifying": dbus.Boolean(False),
            "Descriptors": dbus.Array([], signature="o"),
        }
        dbus.service.Object.__init__(self, bus, path)

    def add_desc(self, desc):
        self._descriptors.append(desc)
        self.props["Descriptors"].append(dbus.ObjectPath(desc.path))

    # org.freedesktop.DBus.Properties
    @dbus.service.method("org.freedesktop.DBus.Properties",
                         in_signature="ss", out_signature="v")
    def Get(self, interface, prop):
        if prop not in self.props:
            raise dbus.exceptions.DBusException(
                "org.freedesktop.DBus.Error.InvalidArgs", "no such property: %s" % prop)
        return self.props[prop]

    @dbus.service.method("org.freedesktop.DBus.Properties",
                         in_signature="s", out_signature="a{sv}")
    def GetAll(self, interface):
        return sdict(self.props)

    @dbus.service.method("org.freedesktop.DBus.Properties",
                         in_signature="ssv", out_signature="")
    def Set(self, interface, prop, value):
        self.props[prop] = value

    # org.bluez.GattCharacteristic1
    @dbus.service.method("org.bluez.GattCharacteristic1",
                         in_signature="a{sv}", out_signature="ay")
    def ReadValue(self, options):
        return ba(self._value)

    @dbus.service.method("org.bluez.GattCharacteristic1",
                         in_signature="aya{sv}", out_signature="")
    def WriteValue(self, value, options):
        self._value = bytearray(value)
        self.on_write(self._value)

    @dbus.service.method("org.bluez.GattCharacteristic1", in_signature="", out_signature="")
    def StartNotify(self):
        self._notifying = True
        self.props["Notifying"] = dbus.Boolean(True)
        log("手机订阅了 %s" % self.path)

    @dbus.service.method("org.bluez.GattCharacteristic1", in_signature="", out_signature="")
    def StopNotify(self):
        self._notifying = False
        self.props["Notifying"] = dbus.Boolean(False)
        log("手机取消订阅 %s" % self.path)

    def on_write(self, value):
        pass

    def notify(self, data):
        self._value = bytearray(data)
        self.props["Value"] = ba(self._value)
        if not self._notifying:
            return False
        try:
            self.PropertiesChanged("org.bluez.GattCharacteristic1",
                                   {"Value": ba(self._value)}, [])
        except Exception as e:  # noqa: BLE001
            log("notify 失败: %s" % e)
            return False
        return True


