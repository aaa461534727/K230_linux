[Unit]
Description=Miracast sink: wfd-sink -> v4l2_dec (K230 mvx 硬解) -> drmplay (DRM 直出)
After=network.target

[Service]
Type=simple
# 三个进程串成管道; 任一环节挂掉 sh 退出, systemd 拉起整条链路
ExecStart=/bin/sh -c '/usr/bin/wfd-sink -d /dev/stdout 2>>/var/log/miracast.log | /usr/bin/v4l2_dec /dev/stdin /dev/stdout -H 2>>/var/log/miracast-dec.log | /usr/bin/drmplay -H -p nv12 -w 480 -h 800 -r 30 2>>/var/log/miracast-play.log'
Restart=always
RestartSec=2
KillMode=control-group

[Install]
WantedBy=multi-user.target
