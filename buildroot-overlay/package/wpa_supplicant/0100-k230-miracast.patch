+/*
+ * K230: Miracast sink 对外"假装修不是 GO"——对齐已在空口验证可连的海奇 sink。
+ *
+ * 实测 (REDMI K80 Ultra / MIUI, 抓包 captures/20261022-1505-k230-v11-fix.pcap):
+ *   我们组对外 group_capab=0x0b (GO 位=1) 时, 手机改走 "join 已有组" 流程:
+ *   只发 Provision Discovery, 收到响应后不再发任何帧, 每 30s 重发一次 PD, 一直转圈。
+ *   海奇 sink 对外 group_capab=0x00 (GO 位=0, 且只回 probe 不发 beacon) 时,
+ *   手机走 GO Negotiation -> 被拒(status=1 信息暂不可用) -> Invitation Req -> client 入组, 成功。
+ *
+ * 开关: 环境变量 P2P_HIDE_GO=0 可恢复原生行为 (默认隐藏)。
+ * 见 docs/K230_MIRACAST_P2P_FLOW.md
+ */
+static int p2p_hide_go_bit(void)
+{
+	static int cached = -1;
+	const char *v;
+
+	if (cached >= 0)
+		return cached;
+	v = getenv("P2P_HIDE_GO");
+	cached = (v && os_strcmp(v, "0") == 0) ? 0 : 1;
+	return cached;
+}
