# /etc/systemd/system/k230-miracast.service
# 2026-10-27 基线: Miracast 走 client 形态 (K230 当 P2P client, 手机/PC 当 GO)
#   这是 2026-10-27 现场验证 PC + 红米 K80 + 努比亚 三台都能投 的唯一形态。
#   GO 形态 (本机当 GO, 手机当 STA) 在真机上必然卡在 手机发完 PD 就不说话,
#   已在 2026-10-21 ~ 10-27 反复证伪 (换 4 个 supplicant 版本都不动), 不要再改回去。
#   细节: /root/k230-baseline-20261027/README.md + 仓内 K230/docs/BASELINE.md
[Unit]
Description=K230 Miracast sink (client: 本机当 P2P client, 手机/PC 当 GO)
After=local-fs.target systemd-udevd.service
Wants=systemd-udevd.service

[Service]
Type=simple
# 2026-10-28 连接稳定性 (K80 实测闭环, 见 docs/PROGRESS.md):
#   WFD_FORCE_OPER_CH=1  钉死组信道 ch1 —— 不钉时 MTK 手机会把组起在 ch8/2447,
#     我们的合法 AUTH 一帧都收不到 ⇒ 15 s 超时 "无法连接", 怎么点都不成。
#   WFD_PERSISTENT_RECONNECT=0 (脚本默认) 拒绝对端 Invitation, 每次全新协商,
#     否则手机用存下的旧组重连, 又把组带回 ch8。
# 2026-11-02 (统一仲裁): wlan1 被 CarPlay/CarLife 的共享热点占成 AP,
#   Miracast 改用 wlan0 做 P2P(STA 侧), 这样热点与投屏可以同时待命。
#   实测 (2026-11-02): wlan0 起 P2P device 后 wlan1 的 hostapd/AP 不受影响。
Environment=WFD_IFACE=wlan0
# 2026-11-07: P2P listen 必须与 AP 同信道 (AP 在 ch6=2437)。8189fs 只有一颗 radio:
#   listen 钉 ch1 时, wlan1 的 beacon TX 直接归零 -> 手机连得上 SSID 也拿不到 IP;
#   实测 GO_FREQ=2437 后 AP 与 P2P 可同时在线 (station 保持 + ping 0% loss + 7236 LISTEN)。
Environment=WFD_GO_FREQ=2437
Environment=WFD_FORCE_OPER_CH=1
Environment=WFD_PERSISTENT_RECONNECT=0
ExecStartPre=/bin/rm -f /run/wfd-p2p.hold
ExecStart=/bin/sh /root/wfd-p2p.sh client
ExecStop=/bin/sh /root/wfd-p2p.sh stop
Restart=always
RestartSec=5
KillMode=control-group
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
