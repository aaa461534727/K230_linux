+/*
+ * K230 (2026-11-10): listen-only 被动应答时 p2p->go_intent 恒为 0,
+ * 导致 GO Negotiation Response 永远报 Intent 0, 手机拿 GO。
+ * 这里在收到 GO-Neg Request 时从 /run/wfd-go-intent 读取期望值
+ * (0..15; 文件不存在 = 0, 保持原 client 行为)。
+ */
+static void k230_apply_go_intent(struct p2p_data *p2p)
+{
+	FILE *f;
+	int v = 0;
+
+	f = fopen("/run/wfd-go-intent", "r");
+	if (f) {
+		if (fscanf(f, "%d", &v) != 1 || v < 0 || v > 15)
+			v = 0;
+		fclose(f);
+	}
+	p2p->go_intent = (u8) v;
+	p2p_dbg(p2p, "K230P2P: responder go_intent=%d", v);
+}
+
 void p2p_process_go_neg_req(struct p2p_data *p2p, const u8 *sa,
 			    const u8 *data, size_t len, int rx_freq)
 {
@@ -884,6 +905,8 @@
 	int tie_breaker = 0;
 	int freq;
 
+	k230_apply_go_intent(p2p);
+
 	p2p_dbg(p2p, "Received GO Negotiation Request from " MACSTR "(freq=%d)",
 		MAC2STR(sa), rx_freq);
 
