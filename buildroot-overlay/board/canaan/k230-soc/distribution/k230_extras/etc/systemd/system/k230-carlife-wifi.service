[Unit]
Description=K230 CarLife wireless (WiFi/TCP) sink
After=network.target k230-screen.service k230-carlife-ap.service
Wants=k230-carlife-ap.service

[Service]
Type=simple
# 2026-10-30 真机打通: 听 UDP 7999 的 "CarlifeHost" 广播, 再连手机 7240/8240/9240-9242/9340/9440
# 2026-11-03 零拷贝 + 最低延迟投喂 (carlife_sink fork 出来的 v4l2_dec 继承这两个环境变量;
#   必须与 k230-screen.sh 的 WFD_SHM 一致, 一端开一端不开会解析错帧头)。
#   板上 1080p/30fps A/B: 管道延迟 82.6~85.0 ms → 19.4~21.2 ms, 每帧CPU 14.50 → 12.16 ms。
Environment=WFD_SHM=/run/wfd-frame
Environment=DEC_AU=2
ExecStart=/root/carlife/carlife_sink --wifi --verbose
Restart=always
RestartSec=3
KillMode=control-group
# 2026-11-06: 会话标记的兜底清理 —— drmplay 认 /run/carlife-active 后"无限保持最后一帧",
# 崩溃/重启留下的陈旧标记会让屏永远停在上一帧, 所以停机时一律清掉。
ExecStopPost=/bin/rm -f /run/carlife-active

[Install]
WantedBy=multi-user.target
