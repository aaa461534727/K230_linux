class GattApp(dbus.service.Object):
    """GATT 应用根对象: BlueZ 上来先调 GetManagedObjects 拿全表。"""

    def __init__(self, bus):
        self.path = APP_PATH
        self.services = []          # [(path, props)]
        self.chars = []             # [(path, props)]
        self.descs = []             # [(path, props)]
        dbus.service.Object.__init__(self, bus, self.path)

    def add_service(self, svc):
        self.services.append((svc.path, svc.props))

    def add_char(self, ch):
        self.chars.append((ch.path, ch.props))
        for d in ch._descriptors:
            self.descs.append((d.path, d.props))

    @dbus.service.method("org.freedesktop.DBus.ObjectManager",
                         in_signature="", out_signature="a{oa{sa{sv}}}")
    def GetManagedObjects(self):
        out = dbus.Dictionary({}, signature="oa{sa{sv}}")
        buckets = (("org.bluez.GattService1", self.services),
                   ("org.bluez.GattCharacteristic1", self.chars),
                   ("org.bluez.GattDescriptor1", self.descs))
        for iface, items in buckets:
            for path, props in items:
                p = dbus.ObjectPath(path)
                out.setdefault(p, dbus.Dictionary({}, signature="sa{sv}"))
                out[p][dbus.String(iface)] = sdict(props)
        return out


