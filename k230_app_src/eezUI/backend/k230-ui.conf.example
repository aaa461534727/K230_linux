# /etc/k230-ui.conf —— 主界面按钮 -> 投屏服务的映射
#
# 这个文件是给 k230-ui-mode.sh 读的 (板端)。改完不用重启 backend,
# 下次点按钮就生效 (脚本每次执行都重新 source)。
#
# 左边是 UI 上的 4 个按钮, 右边是要 systemctl start 的 unit 列表 (空格分隔)。
# 想先确认 unit 名字: systemctl list-unit-files | grep -E 'k230|carplay'

# Miracast (安卓无线投屏, 走 wlan0 的 P2P)
# ★ 2026-11-10: current product form = board GO + phone client ⇒ goneg unit.
UNITS_miracast="k230-miracast-goneg"

# AirPlay (iOS 镜像, uxplay 在 7100/7101)
UNITS_airplay="k230-airplay"

# CarLife —— 默认**无线**。
# ⚠ 有线 (k230-carlife) 会把本板 USB gadget 切到 AOA 模式, 同时切走调试网卡
#   (enxf8e43b5a917e), 也就是 SSH 会断。要用有线就改成:
#     UNITS_carlife="k230-carlife"
UNITS_carlife="k230-carlife-wifi"

# CarPlay (需要 carplay-arbiter/airplayd/wireless 三个一起)
UNITS_carplay="carplay-arbiter carplay-airplayd carplay-wireless"

# ---- 以下是基础设施单元, 一般不用改 ----
# 主界面程序 / 屏幕所有者 (drmplay) / 开机仲裁器
UI_UNIT=${UI_UNIT:-k230-ui}
SCREEN_UNIT=${SCREEN_UNIT:-k230-screen}
ARBITER_UNIT=${ARBITER_UNIT:-k230-source-arbiter}
