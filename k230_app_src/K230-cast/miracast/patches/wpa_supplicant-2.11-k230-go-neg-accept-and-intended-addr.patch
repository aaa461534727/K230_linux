+	/*
+	 * K230P2P (2026-10-23): auto-accept an inbound GO Negotiation Request
+	 * that uses PBC, even though the UI never issued P2P_CONNECT for this
+	 * peer.
+	 *
+	 * Why: as a Miracast sink we stay in P2P device / Listen state. The
+	 * Android source runs Provision Discovery first, shows the user a
+	 * confirmation dialog, and only after the user taps "accept" does it
+	 * send GO Negotiation Request (go_intent=15). By that time we have no
+	 * go_neg_peer / wps_method for the peer, so the stock code answered
+	 * status=1 (INFO_CURRENTLY_UNAVAILABLE) and the phone dropped the
+	 * connection: "PD ok, dialog ok, then nothing".
+	 *
+	 * PBC carries no secret, so accepting it here is equivalent to the user
+	 * tapping accept on the sink side. Our configured go_intent (0) decides
+	 * the role, i.e. the phone wins and becomes GO.
+	 */
+	if (dev && !p2p->go_neg_peer && dev->wps_method == WPS_NOT_READY &&
+	    msg.dev_password_id == DEV_PW_PUSHBUTTON) {
+		wpa_printf(MSG_DEBUG, "K230P2P: auto-accept GO Neg Req from "
+			   MACSTR " with PBC", MAC2STR(sa));
+		dev->wps_method = WPS_PBC;
+		dev->go_neg_req_sent = 0;
+		dev->connect_reqs = 0;
+		dev->flags &= ~(P2P_DEV_USER_REJECTED | P2P_DEV_NOT_YET_READY);
+	}
