diff --git a/rust/carplayd/crates/iap2-core/src/mfi.rs b/rust/carplayd/crates/iap2-core/src/mfi.rs
index ab8622b..17a236a 100644
--- a/rust/carplayd/crates/iap2-core/src/mfi.rs
+++ b/rust/carplayd/crates/iap2-core/src/mfi.rs
@@ -51,15 +51,80 @@ pub fn oracle_ready() -> bool {
 }
 
 /// Fetch the accessory certificate (op `0x01`), retrying through transient chip failures.
+///
+/// K230 PATCH (0002): 先试**本地离线身份** (`CARPLAY_MFI_DIR` 或 `/etc/carplay/mfi`), 没有才回落 oracle。
 pub fn cert() -> Option<Vec<u8>> {
+    if let Some(dir) = local::dir() {
+        match std::fs::read(dir.join(local::CERT_FILE)) {
+            Ok(c) => {
+                eprintln!("[mfi] 本地身份: 证书 {} B ({})", c.len(), dir.display());
+                return Some(c);
+            }
+            Err(e) => eprintln!("[mfi] 本地证书不可读 ({}): 回落 oracle", e),
+        }
+    }
     retry(|| request(0x01, &[]))
 }
 
 /// Sign a challenge digest (op `0x02`), retrying through transient chip failures.
+///
+/// K230 PATCH (0002): 本地身份走 ECDSA P-256 (**NONEwithECDSA 语义**: 传进来的就是摘要, 不再哈希),
+/// 输出 **64 B 原始 r‖s**, 与 PlayPort `LocalMfiAuthenticationClient.signChallenge` 逐字节一致;
+/// 上游 oracle 假设的是 RSA-1024 的 128 B, 两者长度不同 —— iOS 按证书类型自行判断, 不用改报文结构。
 pub fn sign(challenge: &[u8]) -> Option<Vec<u8>> {
+    if let Some(dir) = local::dir() {
+        match local::sign(&dir, challenge) {
+            Some(sig) => return Some(sig),
+            None => eprintln!("[mfi] 本地签名失败: 回落 oracle"),
+        }
+    }
     retry(|| request(0x02, challenge))
 }
 
+/// 本地离线 MFi 身份 (EC P-256 / PKCS#8)。
+///
+/// 与 PlayPort `LocalMfiAuthenticationClient` (Kotlin) 的三条硬性一致:
+///   · 证书 = `certificate.p7b` **整个 PKCS#7 DER 原样**返回 (不是抽出来的 X.509) —— PlayPort 的
+///     `readCertificate()` 就是 `certificate.copyOf()`;
+///   · 签名 = `Signature.getInstance("NONEwithECDSA")` 对**已给的摘要**签名, 不做二次哈希;
+///   · 输出 = DER 转 **raw r‖s (64 B)**, 不是 DER。
+mod local {
+    use p256::ecdsa::signature::hazmat::PrehashSigner;
+    use p256::ecdsa::{Signature, SigningKey};
+    use p256::pkcs8::DecodePrivateKey;
+    use std::path::{Path, PathBuf};
+
+    pub const DIR_ENV: &str = "CARPLAY_MFI_DIR";
+    pub const DEFAULT_DIR: &str = "/etc/carplay/mfi";
+    pub const CERT_FILE: &str = "certificate.p7b";
+    pub const KEY_FILE: &str = "identity.pk8";
+
+    /// 目录存在且两个文件都在才算"配置了本地身份"; 否则返回 None 让调用方回落 oracle。
+    pub fn dir() -> Option<PathBuf> {
+        let d = std::env::var_os(DIR_ENV)
+            .map(PathBuf::from)
+            .unwrap_or_else(|| PathBuf::from(DEFAULT_DIR));
+        if d.join(CERT_FILE).is_file() && d.join(KEY_FILE).is_file() {
+            Some(d)
+        } else {
+            None
+        }
+    }
+
+    pub fn sign(dir: &Path, digest: &[u8]) -> Option<Vec<u8>> {
+        if digest.len() != 32 {
+            // PlayPort: require(challenge.size == 32) { "Local MFi v3 expects a 32-byte digest" }
+            eprintln!("[mfi] 挑战长度 {} ≠ 32 (本地身份只支持 32 B 摘要)", digest.len());
+            return None;
+        }
+        let der = std::fs::read(dir.join(KEY_FILE)).ok()?;
+        let key = SigningKey::from_pkcs8_der(&der).ok()?;
+        // PrehashSigner = NONEwithECDSA: 输入即摘要, 内部不再做 SHA-256
+        let sig: Signature = key.sign_prehash(digest).ok()?;
+        Some(sig.to_bytes().to_vec())
+    }
+}
+
 fn retry(mut f: impl FnMut() -> Option<Vec<u8>>) -> Option<Vec<u8>> {
     for _ in 0..RETRIES {
         if let Some(v) = f() {
