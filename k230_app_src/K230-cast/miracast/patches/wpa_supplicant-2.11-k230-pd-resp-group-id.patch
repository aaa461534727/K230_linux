+/**
+ * p2p_group_get_ssid - Get the SSID of a running group
+ * @group: P2P group
+ * @len: Buffer for returning the SSID length
+ * Returns: Pointer to the SSID (valid as long as the group exists)
+ *
+ * K230 addition: needed to advertise P2P Group ID in a Provision Discovery
+ * Response so that a peer can join the group that is already running.
+ */
+const u8 * p2p_group_get_ssid(struct p2p_group *group, size_t *len)
+{
+	if (!group || !group->cfg || !len)
+		return NULL;
+	*len = group->cfg->ssid_len;
+	return group->cfg->ssid;
+}
+
