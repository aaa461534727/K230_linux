+	/*
+	 * K230P2P (2026-10-23): never advertise an all-zero Intended P2P
+	 * Interface Address.
+	 *
+	 * Why: on this board P2P runs on the primary interface
+	 * (p2p_no_group_iface=1), so the driver never supplies a separate P2P
+	 * interface address and p2p->intended_addr stays 00:00:00:00:00:00.
+	 * The peer GO then has no idea which MAC will associate, sets up its
+	 * station ACL for the all-zero address and drops our Authentication
+	 * frames at the MAC layer (observed: 31 auth reqs at -24 dBm, zero
+	 * ACKs). Fall back to our own device address, which is exactly the
+	 * address the association will come from.
+	 */
+	{
+		static const u8 zero_addr[ETH_ALEN] = { 0, 0, 0, 0, 0, 0 };
+		const u8 *intended = p2p->intended_addr;
+
+		if (os_memcmp(intended, zero_addr, ETH_ALEN) == 0)
+			intended = p2p->cfg->dev_addr;
+		p2p_buf_add_intended_addr(buf, intended);
+	}
 	if (p2p->num_pref_freq) {
