+/// 0x4301 CarPlayStartSession —— 让手机真正起 CarPlay 会话。
+///
+/// 参数布局逐条对齐 PlayPort `Iap2CarPlayMessages.startSession` (Kotlin):
+///   group 1 (wireless): 0=SSID(str) 1=passphrase(str) 2=channel(u8) 3=IP[](str) 4=securityType(u8)
+///   field 2: airPlayPort (u32 = 7000)
+///   field 3: deviceIdentifier (str, 本机 BT MAC)
+///   field 4: publicKey (str, **Curve25519 公钥的 64 字符 hex**, 不是 32 字节二进制)
+///   field 5: sourceVersion (str "366.0")
+///   field 6: sdkVersion (str)
+///   group 7: clusterAsset {0=assetId(str) 1=assetVersion(u32)}
+///   field 8: mutualAuth (u8 0/1)
+fn send_carplay_start(link: &mut Link, sock: &mut File, abort: &dyn Fn() -> bool) -> bool {
+    let env = |k: &str, d: &str| std::env::var(k).ok().filter(|v| !v.is_empty()).unwrap_or_else(|| d.to_string());
+    let ssid = env("CARPLAY_AP_SSID", "K230-CARPLAY");
+    let pass = env("CARPLAY_AP_PASS", "k230carplay");
+    let channel: u8 = std::env::var("CARPLAY_AP_CHANNEL").ok().and_then(|v| v.parse().ok()).unwrap_or(6);
+    let ip = env("CARPLAY_AP_IP", "192.168.50.1");
+    let port: u32 = std::env::var("CARPLAY_AIRPLAY_PORT").ok().and_then(|v| v.parse().ok()).unwrap_or(7000);
+
+    let dev_id = format!(
+        "{:02X}:{:02X}:{:02X}:{:02X}:{:02X}:{:02X}",
+        ACCESSORY_BT_MAC[0], ACCESSORY_BT_MAC[1], ACCESSORY_BT_MAC[2],
+        ACCESSORY_BT_MAC[3], ACCESSORY_BT_MAC[4], ACCESSORY_BT_MAC[5]
+    );
+    let pubkey = match airplay_public_key_hex() {
+        Some(k) => k,
+        None => {
+            log("✗ 生成/读取 AirPlay 长钥失败, 不发 0x4301");
+            return false;
+        }
+    };
+
+    // group 1 (wireless)
+    let g1_inner = {
+        let mut g = message::Tlv::new();
+        g.str(0, &ssid);
+        g.str(1, &pass);
+        g.u8v(2, channel);
+        g.str(3, &ip);
+        g.u8v(4, 2); // WPA2 Personal
+        g.0
+    };
+    let mut body: Vec<u8> = wrap_group(1, g1_inner);
+
+    let mut f = message::Tlv::new();
+    f.u32v(2, port);
+    f.str(3, &dev_id);
+    f.str(4, &pubkey);
+    f.str(5, &env("CARPLAY_SOURCE_VERSION", "366.0"));
+    f.str(6, &env("CARPLAY_SDK_VERSION", "366.0"));
+    body.extend_from_slice(&f.0);
+
+    let ca_inner = {
+        let mut g = message::Tlv::new();
+        g.str(0, "com.apple.carplay.asset");
+        g.u32v(1, 1);
+        g.0
+    };
+    body.extend_from_slice(&wrap_group(7, ca_inner));
+
+    let mut m = message::Tlv::new();
+    m.u8v(8, 1); // mutualAuth
+    body.extend_from_slice(&m.0);
+
+    let ok = write_interruptible(sock, &link.build_msg(1, spec::MSG_CAR_PLAY_START_SESSION, &body), abort);
+    log(&format!(
+        "TX 0x4301 CarPlayStartSession ({} B) ssid={ssid} ch={channel} ip={ip} port={port} dev={dev_id} pubkey={}…",
+        body.len(),
+        &pubkey[..16.min(pubkey.len())]
+    ));
+    ok
+}
+
+/// TLV 组: [len BE16][pid BE16][子 TLV...], len 含 4 字节头 (与 PlayPort 的 group() 同构)。
+fn wrap_group(pid: u16, inner: Vec<u8>) -> Vec<u8> {
+    let mut v = Vec::with_capacity(inner.len() + 4);
+    v.extend_from_slice(&((4 + inner.len()) as u16).to_be_bytes());
+    v.extend_from_slice(&pid.to_be_bytes());
+    v.extend_from_slice(&inner);
+    v
+}
+
+/// AirPlay 长钥 (Curve25519)。持久化在 /etc/carplay/airplay.key, 首次自动生成 —— 换钥会导致
+/// 已配对手机重配, 所以必须落盘而不是每次随机。
+fn airplay_public_key_hex() -> Option<String> {
+    use rand_core::OsRng;
+    use x25519_dalek::{PublicKey, StaticSecret};
+
+    let path = std::env::var("CARPLAY_AIRPLAY_KEY").unwrap_or_else(|_| "/etc/carplay/airplay.key".into());
+    let secret = match std::fs::read(&path) {
+        Ok(b) if b.len() == 32 => {
+            let mut a = [0u8; 32];
+            a.copy_from_slice(&b);
+            StaticSecret::from(a)
+        }
+        _ => {
+            let s = StaticSecret::random_from_rng(OsRng);
+            if let Some(dir) = std::path::Path::new(&path).parent() {
+                let _ = std::fs::create_dir_all(dir);
+            }
+            if std::fs::write(&path, s.to_bytes()).is_err() {
+                log(&format!("⚠ 无法写 {path}, 长钥只在本次进程内有效"));
+            } else {
+                log(&format!("生成长钥并落盘: {path}"));
+            }
+            s
+        }
+    };
+    let pk = PublicKey::from(&secret);
+    Some(pk.as_bytes().iter().map(|b| format!("{b:02x}")).collect())
+}
